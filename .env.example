# ==============================================================================
# Configuration du serveur Matrix — Copiez ce fichier en .env et remplissez
# ==============================================================================

# ------------------------------------------------------------------------------
# Domaine et identité du serveur
# ------------------------------------------------------------------------------

# Domaine complet où tourne le serveur (ex: matrix.mondomaine.fr)
# → C'est l'adresse que vous configurerez dans votre DNS.
MATRIX_DOMAIN=matrix.mondomaine.fr

# Nom du serveur Matrix pour les identifiants utilisateurs (ex: mondomaine.fr)
# → Les comptes auront la forme @utilisateur:MATRIX_SERVER_NAME
#
# CAS SIMPLE (recommandé) : même valeur que MATRIX_DOMAIN
#   MATRIX_SERVER_NAME=matrix.mondomaine.fr  → IDs : @user:matrix.mondomaine.fr
#
# CAS AVANCÉ : domaine court (nécessite un .well-known sur mondomaine.fr)
#   MATRIX_SERVER_NAME=mondomaine.fr         → IDs : @user:mondomaine.fr
#   (Voir la section "Délégation de domaine" dans le README)
MATRIX_SERVER_NAME=matrix.mondomaine.fr

# ------------------------------------------------------------------------------
# Base de données PostgreSQL
# ------------------------------------------------------------------------------

POSTGRES_USER=synapse
# ⚠️  Changez ce mot de passe avant de déployer !
# Si le mot de passe contient des caractères spéciaux (ex: $, #, espaces),
# vous pouvez l'entourer de guillemets.
POSTGRES_PASSWORD=changez_ce_mot_de_passe_fort_et_unique
POSTGRES_DB=synapse

# ------------------------------------------------------------------------------
# Certificat SSL — Let's Encrypt
# ------------------------------------------------------------------------------

# Email utilisé pour les notifications d'expiration du certificat
# (Optionnel si REVERSE_PROXY=traefik — Traefik gère ses propres certificats)
LETSENCRYPT_EMAIL=admin@mondomaine.fr

# ------------------------------------------------------------------------------
# Reverse proxy externe (optionnel)
# ------------------------------------------------------------------------------

# Si vous utilisez Traefik comme reverse proxy, décommentez la ligne suivante.
# Cela désactive nginx et certbot — le SSL est géré par Traefik.
# REVERSE_PROXY=traefik

# ------------------------------------------------------------------------------
# Options Synapse
# ------------------------------------------------------------------------------

# Autoriser l'inscription publique sans invitation ? (true / false)
# false = serveur privé (recommandé), true = serveur public
SYNAPSE_ALLOW_REGISTRATION=false

# ------------------------------------------------------------------------------
# Ports (optionnel — utile pour les tests locaux)
# ------------------------------------------------------------------------------

# En production laisser vide (defaults : 80, 443, 8448)
# En test local, décommenter les lignes suivantes :
# HTTP_PORT=8090
# HTTPS_PORT=8443
# FED_PORT=8448

# ------------------------------------------------------------------------------
# Element Call — Appels audio/vidéo (optionnel)
# ------------------------------------------------------------------------------

# Pour activer les appels dans Element, il faut un serveur LiveKit (SFU).
# Décommentez les lignes suivantes et renseignez vos valeurs.
#
# LIVEKIT_API_KEY / LIVEKIT_API_SECRET : identifiants d'accès à LiveKit
#
# LIVEKIT_URL : URL WebSocket publique de LiveKit (utilisée par les clients)
#   - En mode Traefik/nginx : cette valeur est déduite automatiquement
#     (wss://MATRIX_DOMAIN) car le signaling passe par le reverse proxy.
#     Vous pouvez l'omettre ou la laisser vide.
#   - Ne renseignez cette valeur que si vous hébergez LiveKit séparément
#     (ex: LIVEKIT_URL=wss://livekit.mondomaine.fr)
#
# Exemple :
# LIVEKIT_API_KEY=ma_cle_api
# LIVEKIT_API_SECRET=mon_secret_api
# LIVEKIT_URL=wss://livekit.mondomaine.fr
#
# ⚠️  LIVEKIT_API_KEY et LIVEKIT_API_SECRET doivent être renseignées pour
# activer Element Call. LIVEKIT_URL est optionnel (déduit si absent).
# Si elles sont absentes, les appels ne seront pas disponibles (cela
# n'empêche pas le fonctionnement du chat).
