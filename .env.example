# ==============================================================================
# Configuration du serveur Matrix — Copiez ce fichier en .env et remplissez
# ==============================================================================

# ------------------------------------------------------------------------------
# Domaine et identité du serveur
# ------------------------------------------------------------------------------

# Domaine complet où tourne le serveur (ex: matrix.mondomaine.fr)
# → C'est l'adresse que vous configurerez dans votre DNS.
MATRIX_DOMAIN=matrix.mondomaine.fr

# Nom du serveur Matrix pour les identifiants utilisateurs (ex: mondomaine.fr)
# → Les comptes auront la forme @utilisateur:MATRIX_SERVER_NAME
#
# CAS SIMPLE (recommandé) : même valeur que MATRIX_DOMAIN
#   MATRIX_SERVER_NAME=matrix.mondomaine.fr  → IDs : @user:matrix.mondomaine.fr
#
# CAS AVANCÉ : domaine court (nécessite un .well-known sur mondomaine.fr)
#   MATRIX_SERVER_NAME=mondomaine.fr         → IDs : @user:mondomaine.fr
#   (Voir la section "Délégation de domaine" dans le README)
MATRIX_SERVER_NAME=matrix.mondomaine.fr

# ------------------------------------------------------------------------------
# Base de données PostgreSQL
# ------------------------------------------------------------------------------

POSTGRES_USER=synapse
# ⚠️  Changez ce mot de passe avant de déployer !
POSTGRES_PASSWORD=changez_ce_mot_de_passe_fort_et_unique
POSTGRES_DB=synapse

# ------------------------------------------------------------------------------
# Certificat SSL — Let's Encrypt
# ------------------------------------------------------------------------------

# Email utilisé pour les notifications d'expiration du certificat
LETSENCRYPT_EMAIL=admin@mondomaine.fr

# ------------------------------------------------------------------------------
# Options Synapse
# ------------------------------------------------------------------------------

# Autoriser l'inscription publique sans invitation ? (true / false)
# false = serveur privé (recommandé), true = serveur public
SYNAPSE_ALLOW_REGISTRATION=false

# ------------------------------------------------------------------------------
# Ports (optionnel — utile pour les tests locaux)
# ------------------------------------------------------------------------------

# En production laisser vide (defaults : 80, 443, 8448)
# En test local, décommenter les lignes suivantes :
# HTTP_PORT=8090
# HTTPS_PORT=8443
# FED_PORT=8448
